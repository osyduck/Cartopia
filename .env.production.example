# Cartopia — production environment.
# Copy to .env.production, fill in real secrets, then:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# The same file is read by docker-compose (for ${VAR} interpolation in the
# postgres/minio containers) AND loaded into web/worker via env_file.
# Keep META_DB_PASSWORD / DATAPLANE_DB_PASSWORD in sync with the URLs below.

# ─── Secrets — generate each with: openssl rand -base64 48 ──────────────────
META_DB_PASSWORD="change-me-metadata-pg-password"
DATAPLANE_DB_PASSWORD="change-me-dataplane-pg-password"
APP_SECRET="change-me-32-bytes-minimum-secret-xxxxxxxxxxxxxxxx"

# Single panel admin (seeded by `npm run db:seed`).
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="change-me-strong-password"

# MinIO / S3 credentials (also used as MINIO_ROOT_USER/PASSWORD in compose).
S3_ACCESS_KEY="cartopia-minio"
S3_SECRET_KEY="change-me-minio-secret"

# ─── Control plane (docker service: metadata-pg, internal port 5432) ────────
# NOTE: password must match META_DB_PASSWORD above.
METADATA_DATABASE_URL="postgres://cartopia:change-me-metadata-pg-password@metadata-pg:5432/cartopia_meta"

# ─── Data plane (docker service: dataplane-pg) ──────────────────────────────
# Cartopia connects as the superuser to run DDL (provision databases/roles).
# Password must match DATAPLANE_DB_PASSWORD above.
DATAPLANE_HOST="dataplane-pg"
DATAPLANE_PORT="5432"
DATAPLANE_ADMIN_USER="postgres"
DATAPLANE_ADMIN_PASSWORD="change-me-dataplane-pg-password"

# Host/port that END-USER connection strings point at — the PUBLIC PgBouncer.
# Set to your VPS domain (recommended) or public IPv4. Tenants connect here.
DATAPLANE_POOLER_HOST="cartopia.example.com"
DATAPLANE_POOLER_PORT="6432"
DATAPLANE_POOLER_SESSION_PORT="6433"

# ─── Worker / jobs ──────────────────────────────────────────────────────────
REDIS_URL="redis://redis:6379"
# Optional: POST quota alerts (Discord/Slack/generic JSON). Empty = log only.
ALERT_WEBHOOK_URL=""

# ─── Backups (MinIO / S3) ───────────────────────────────────────────────────
S3_ENDPOINT="http://minio:9000"
S3_REGION="us-east-1"
S3_BUCKET="cartopia-backups"
S3_FORCE_PATH_STYLE="true"
BACKUP_RETENTION_DAYS="7"
# Worker runs pg_dump INSIDE the dataplane container (PG 17 matched) via the
# docker socket (mounted in docker-compose.prod.yml). This is also set as an
# environment override on the worker service.
BACKUP_DOCKER_CONTAINER="cartopia-dataplane-pg"
BACKUP_CRON="0 2 * * *"

# ─── Sweep intervals (seconds) ──────────────────────────────────────────────
QUOTA_SWEEP_INTERVAL_SECONDS="60"
METRICS_SWEEP_INTERVAL_SECONDS="60"
