# ─── Control plane ──────────────────────────────────────────────────────────
# Cartopia's own metadata database (NOT a managed database).
METADATA_DATABASE_URL="postgres://cartopia:cartopia_meta_pw@localhost:5433/cartopia_meta"

# 32+ byte secret. Signs the admin session cookie AND encrypts stored data-plane
# admin passwords. Generate with: openssl rand -base64 48
APP_SECRET="dev-only-change-me-please-32-bytes-minimum-secret"

# Single panel admin, seeded by `npm run db:seed`.
ADMIN_EMAIL="admin@cartopia.local"
ADMIN_PASSWORD="changeme123"

# ─── Default data plane instance (seeded into the `instances` table) ─────────
# Provisioning connects here as a superuser / role with CREATEDB + CREATEROLE.
DATAPLANE_HOST="localhost"
DATAPLANE_PORT="5432"
DATAPLANE_ADMIN_USER="postgres"
DATAPLANE_ADMIN_PASSWORD="dataplane_super_pw"
# Host/port that end-user connection strings should point at (PgBouncer).
DATAPLANE_POOLER_HOST="localhost"
DATAPLANE_POOLER_PORT="6432"

# ─── Worker / jobs ──────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Backups (MinIO / S3) ───────────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="cartopia-backups"
S3_FORCE_PATH_STYLE="true"
BACKUP_RETENTION_DAYS="7"
# Dev: run pg_dump inside this data-plane container (matching version, no host
# client tools needed). Leave empty in prod to use a native pg_dump on PATH.
BACKUP_DOCKER_CONTAINER="cartopia-dataplane-pg"
BACKUP_CRON="0 2 * * *"
